[settings]
compiler.cppstd=gnu20

[options]
qt/*:with_libjpeg=libjpeg-turbo
qt/*:with_odbc=False
qt/*:with_pq=False
qt/*:with_sqlite3=True
qt/*:with_mysql=False
# this should typically be enabled but currently fails on CI due to upstream issue
qt/*:with_fontconfig=False

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.cmake.cmaketoolchain:extra_variables={"LLVM_ENABLE_LLD": "ON", "CMAKE_CXX_COMPILER_LAUNCHER":"ccache", "CMAKE_C_COMPILER_LAUNCHER":"ccache"}
