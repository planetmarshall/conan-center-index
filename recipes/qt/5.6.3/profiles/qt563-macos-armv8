# Build Qt 5.6.3 (opensource) as a Conan binary package for macOS ARM64
# (Apple Silicon).  Reuses the existing entos-macos-armv8 platform profile and
# adds the Qt build options that mirror
#   core-app/scripts/setup_and_build_macos_desktop_qt563.sh
# The produced package is later consumed by epg (qt_from_conan=True) instead of
# a from-source local_sdk install.
include(entos-macos-armv8)

[options]
qt/*:shared=True
qt/*:commercial=False
qt/*:opengl=desktop
qt/*:gui=True
qt/*:widgets=True
# qtdeclarative provides Qml/Quick, required by epg.
qt/*:qtdeclarative=True
qt/*:with_vulkan=False
qt/*:with_glib=False
qt/*:with_dbus=False
# Additional modules to match the local_sdk macos-desktop-arm64-qt563 SDK.
qt/*:qtsvg=True
qt/*:qtimageformats=True
qt/*:qtgraphicaleffects=True
qt/*:qtxmlpatterns=True
qt/*:qtwebsockets=True
qt/*:qtwebchannel=True
qt/*:qtmacextras=True
