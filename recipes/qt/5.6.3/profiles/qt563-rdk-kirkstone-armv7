# Build Qt 5.6.3 (opensource) as a Conan binary package for RDK Kirkstone
# ARMv7 (cross-compiled from a macOS/Linux host).  Reuses the existing
# entos-rdk-kirkstone-armv7 platform profile and adds the Qt build options that
# mirror
#   core-app/scripts/setup_and_build_macos_kirkstone_qt563.sh
# The produced package is later consumed by epg (qt_from_conan=True) instead of
# a from-source local_sdk install.
#
# Building requires RDK_SDK_PATH to point at the extracted RDK SDK (the
# included platform profile reads it to locate the cross toolchain/sysroot).
#
# IMPORTANT: the [options] block below MUST stay byte-for-byte in lockstep with
# the consumer profile
#   core-app/toolchain/profiles/entos-rdk-kirkstone-armv7-qt563
# If the two option sets diverge, the qt/5.6.3 package_id changes and Conan will
# rebuild Qt from source instead of downloading the prebuilt binary.
include(entos-rdk-kirkstone-armv7)

[options]
qt/*:shared=True
qt/*:commercial=False
# Device GPU is OpenGL ES 2 (the qt/5.6.3 recipe also forces this for kirkstone).
qt/*:opengl=es2
qt/*:gui=True
qt/*:widgets=True
# qtdeclarative provides Qml/Quick, required by epg.
qt/*:qtdeclarative=True
qt/*:with_vulkan=False
qt/*:with_glib=False
qt/*:with_dbus=False
# The device renders through Wayland; qtwayland (Qt5WaylandClient + platform
# plugins) is built inline by the qt/5.6.3 recipe, together with the Sky
# wl-simple-shell / skyq-input plugins and the neon/libproxy stubs.
qt/*:qtwayland=True
# No X11 on the device.
qt/*:with_x11=False
# Additional modules to match the local_sdk kirkstone qt563 SDK.
qt/*:qtsvg=True
qt/*:qtimageformats=True
qt/*:qtgraphicaleffects=True
qt/*:qtxmlpatterns=True
qt/*:qtwebsockets=True
qt/*:qtwebchannel=True
# freetype is bundled by Qt 5.6.3 (with_freetype option removed in the recipe),
# so fontconfig (which needs freetype) must stay off.
qt/*:with_fontconfig=False
qt/*:with_icu=False

[conf]
# opengl/system's system_requirements() unconditionally checks for host desktop
# libGL (libgl-dev) on Linux, which the kirkstone cross-build container lacks and
# doesn't need: the ARM target's OpenGL ES 2 comes from the RDK sysroot. Report
# instead of check so the missing host package doesn't fail the build.
opengl/*:tools.system.package_manager:mode=report
