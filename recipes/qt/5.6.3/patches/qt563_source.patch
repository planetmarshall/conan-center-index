+namespace {
+// Inspect the percent sign at index `percentPos` in `text` and decide
+// whether it begins a "%n" or "%Ln" placeholder that replacePercentN()
+// should rewrite. On a match the total span (including the leading '%')
+// is written to *placeholderLen (2 for "%n", 3 for "%Ln") and the
+// function returns true. On any other character sequence, including a
+// lone '%' at the very end of the string, the function returns false
+// without touching *placeholderLen, so the caller knows to leave the
+// percent sign alone and walk past it.
+bool epgInspectPercentN(const QString &text, int percentPos, int *placeholderLen)
+{
+    const int trailing = text.length() - percentPos - 1;
+    if (trailing <= 0) {
+        return false;
+    }
+    int probe = percentPos + 1;
+    int span = 2;
+    if (text.at(probe) == QLatin1Char('L')) {
+        if (trailing < 2) {
+            return false;
+        }
+        ++probe;
+        span = 3;
+    }
+    if (text.at(probe) != QLatin1Char('n')) {
+        return false;
+    }
+    *placeholderLen = span;
+    return true;
+}
+} // namespace
+
 static void replacePercentN(QString *result, int n)
 {
-    if (n >= 0) {
-        int percentPos = 0;
-        int len = 0;
-        while ((percentPos = result->indexOf(QLatin1Char('%'), percentPos + len)) != -1) {
-            len = 1;
-            QString fmt;
-            if (result->at(percentPos + len) == QLatin1Char('L')) {
-                ++len;
-                fmt = QLatin1String("%L1");
-            } else {
-                fmt = QLatin1String("%1");
-            }
-            if (result->at(percentPos + len) == QLatin1Char('n')) {
-                fmt = fmt.arg(n);
-                ++len;
-                result->replace(percentPos, len, fmt);
-                len = fmt.length();
-            }
+    if (n < 0) {
+        return;
+    }
+    int searchFrom = 0;
+    while (true) {
+        const int percentPos = result->indexOf(QLatin1Char('%'), searchFrom);
+        if (percentPos < 0) {
+            break;
         }
+        int placeholderLen = 0;
+        if (!epgInspectPercentN(*result, percentPos, &placeholderLen)) {
+            // Either a trailing lone '%' or a percent sequence that is
+            // not "%n" / "%Ln" — leave it untouched and resume searching
+            // immediately after this percent sign.
+            searchFrom = percentPos + 1;
+            continue;
+        }
+        const QString fmt = QString::fromLatin1(placeholderLen == 3 ? "%L1" : "%1").arg(n);
+        result->replace(percentPos, placeholderLen, fmt);
+        searchFrom = percentPos + fmt.length();
     }
