+// EPG backport: consume a single C++11 attribute-specifier of the form
+//   [[ token-list ]]
+// from the current position in the token stream and return true. If no such
+// specifier is at the cursor, the cursor is left untouched and false is
+// returned. The body of the specifier is treated opaquely: any tokens between
+// the opening `[[` and the matching `]]` are discarded. Nested `[` / `]`
+// pairs inside the body (for example inside a balanced expression argument)
+// are tracked with a small depth counter so we only stop at the genuine
+// closing `]]`. This lets Qt 5.6.3 moc tolerate constructs such as
+//   [[nodiscard]] virtual QString getEnvironmentValue(...) const;
+// in `public slots:` blocks, which are common in modern application code.
+bool Moc::swallowAttributeSpecifier()
+{
+    if (index + 1 >= symbols.size())
+        return false;
+    if (symbols.at(index).token != LBRACK)
+        return false;
+    if (symbols.at(index + 1).token != LBRACK)
+        return false;
+    index += 2;
+    int bracketDepth = 1;
+    while (index < symbols.size() && bracketDepth > 0) {
+        const Token t = symbols.at(index++).token;
+        if (t == LBRACK) {
+            ++bracketDepth;
+        } else if (t == RBRACK) {
+            if (bracketDepth == 1
+                && index < symbols.size()
+                && symbols.at(index).token == RBRACK) {
+                ++index;
+                return true;
+            }
+            --bracketDepth;
+        }
+    }
+    return true;
+}
