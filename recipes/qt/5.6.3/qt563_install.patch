@@ -0,0 +1,32 @@
+// Minimal QRandomGenerator stub for Qt 5.6.3 builds.
+// Provides bounded() using qrand() as the random source.
+#ifndef QRANDOMGENERATOR_H
+#define QRANDOMGENERATOR_H
+
+#include <QtCore/qglobal.h>
+
+QT_BEGIN_NAMESPACE
+
+class QRandomGenerator {
+public:
+    static QRandomGenerator *global() {
+        static QRandomGenerator instance;
+        return &instance;
+    }
+
+    // Returns a value in [0, highest)
+    quint32 bounded(quint32 highest) {
+        if (highest == 0) return 0;
+        return static_cast<quint32>(qrand()) % highest;
+    }
+
+    // Returns a value in [lowest, highest)
+    quint32 bounded(quint32 lowest, quint32 highest) {
+        if (highest <= lowest) return lowest;
+        return lowest + bounded(highest - lowest);
+    }
+};
+
+QT_END_NAMESPACE
+
+#endif // QRANDOMGENERATOR_H
