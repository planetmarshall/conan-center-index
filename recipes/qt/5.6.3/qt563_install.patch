+// QImageReaderWithJpegFallback: subclass of QImageReader that adds JPEG SOI-byte detection
+// as a fallback when format() returns empty (occurs when the device has not been
+// explicitly opened before constructing the reader). Callers do not need to
+// call device.open() or change any detection logic in application code.
+class QImageReaderWithJpegFallback : public QImageReader
+{
+public:
+    QImageReaderWithJpegFallback() : QImageReader() {}
+    explicit QImageReaderWithJpegFallback(QIODevice *device, const QByteArray &format = QByteArray())
+        : QImageReader(device, format) {}
+    explicit QImageReaderWithJpegFallback(const QString &fileName, const QByteArray &format = QByteArray())
+        : QImageReader(fileName, format) {}
+
+    QByteArray format() const
+    {
+        QByteArray fmt = QImageReader::format();
+        if (!fmt.isEmpty())
+            return fmt;
+        if (QIODevice *dev = device()) {
+            const bool wasOpen = dev->isOpen();
+            if (!wasOpen)
+                dev->open(QIODevice::ReadOnly);
+            const QByteArray header = dev->peek(3);
+            if (!wasOpen)
+                dev->close();
+            if (header.size() >= 3 &&
+                static_cast<unsigned char>(header[0]) == 0xFF &&
+                static_cast<unsigned char>(header[1]) == 0xD8 &&
+                static_cast<unsigned char>(header[2]) == 0xFF) {
+                return QByteArray("jpeg");
+            }
+        }
+        return fmt;
+    }
+};
