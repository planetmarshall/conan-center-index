+// QScopeGuard RAII guard class for Qt 5.6.3 builds.
+#pragma once
+
+#include <QtCore/qglobal.h>
+#include <utility>
+
+QT_BEGIN_NAMESPACE
+
+template <typename F>
+class QScopeGuard
+{
+public:
+    explicit QScopeGuard(F &&f) noexcept
+        : m_func(std::move(f)), m_dismissed(false) {}
+
+    explicit QScopeGuard(const F &f) noexcept
+        : m_func(f), m_dismissed(false) {}
+
+    QScopeGuard(QScopeGuard &&other) noexcept
+        : m_func(std::move(other.m_func)), m_dismissed(other.m_dismissed)
+    {
+        other.dismiss();
+    }
+
+    ~QScopeGuard()
+    {
+        if (!m_dismissed)
+            m_func();
+    }
+
+    void dismiss() noexcept { m_dismissed = true; }
+
+private:
+    Q_DISABLE_COPY(QScopeGuard)
+    F m_func;
+    bool m_dismissed;
+};
+
+template <typename F>
+QScopeGuard<typename std::decay<F>::type> qScopeGuard(F &&f)
+{
+    return QScopeGuard<typename std::decay<F>::type>(std::forward<F>(f));
+}
+
+QT_END_NAMESPACE
