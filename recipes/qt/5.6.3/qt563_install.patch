diff -ruN qt563-pristine/include/QtCore/qcborvalue.h qt563-polyfill/include/QtCore/qcborvalue.h
--- qt563-pristine/include/QtCore/qcborvalue.h	2026-06-26 19:42:30
+++ qt563-polyfill/include/QtCore/qcborvalue.h	2026-06-26 19:42:30
@@ -0,0 +1,44 @@
+// Minimal QCborValue stub for Qt 5.6.3 builds.
+// Enum constants follow the CBOR RFC 7049 major-type encoding (not derived from any Qt source).
+#ifndef QCBORVALUE_H
+#define QCBORVALUE_H
+#include <QtCore/qglobal.h>
+#include <QtCore/qstring.h>
+#include <QtCore/qbytearray.h>
+QT_BEGIN_NAMESPACE
+class QCborArray;
+class QCborMap;
+class Q_CORE_EXPORT QCborValue
+{
+public:
+    enum Type {
+        Integer    = 0x00, ByteArray  = 0x40, String     = 0x60,
+        Array      = 0x80, Map        = 0xa0, SimpleType = 0x100,
+        False      = SimpleType + 20, True = SimpleType + 21,
+        Null       = SimpleType + 22, Undefined = SimpleType + 23,
+        Double     = 0x202, Invalid   = -1,
+    };
+    QCborValue() : m_type(Undefined) {}
+    QCborValue(bool b) : m_type(b ? True : False) {}
+    QCborValue(qint64 v) : m_type(Integer), m_integer(v) {}
+    QCborValue(double d) : m_type(Double), m_double(d) {}
+    QCborValue(const QString &s) : m_type(String), m_string(s) {}
+    QCborValue(const QByteArray &ba) : m_type(ByteArray), m_bytes(ba) {}
+    Type type() const { return m_type; }
+    bool isInteger() const { return m_type == Integer; }
+    bool isString() const { return m_type == String; }
+    bool isNull() const { return m_type == Null; }
+    bool isUndefined() const { return m_type == Undefined; }
+    bool isBool() const { return m_type == True || m_type == False; }
+    bool isDouble() const { return m_type == Double; }
+    qint64 toInteger(qint64 defaultValue = 0) const { return isInteger() ? m_integer : defaultValue; }
+    bool toBool(bool defaultValue = false) const { return isBool() ? (m_type == True) : defaultValue; }
+    double toDouble(double d = 0.0) const { return isDouble() ? m_double : d; }
+    QString toString(const QString &d = QString()) const { return isString() ? m_string : d; }
+    QByteArray toByteArray(const QByteArray &d = QByteArray()) const { return (m_type == ByteArray) ? m_bytes : d; }
+private:
+    Type m_type; qint64 m_integer = 0; double m_double = 0.0;
+    QString m_string; QByteArray m_bytes;
+};
+QT_END_NAMESPACE
+#endif // QCBORVALUE_H
