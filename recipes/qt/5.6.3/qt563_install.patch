+/****************************************************************************
+** QStringView stub for Qt 5.6.3 builds.
+** Read-only view of a sequence of UTF-16 characters.
+** This minimal implementation covers the usage patterns in this codebase.
+****************************************************************************/
+#ifndef QSTRINGVIEW_H
+#define QSTRINGVIEW_H
+
+#include <QtCore/qstring.h>
+#include <cstring>
+
+QT_BEGIN_NAMESPACE
+
+class Q_CORE_EXPORT QStringView
+{
+    const char16_t* m_data;
+    int m_size;
+
+public:
+    constexpr QStringView() Q_DECL_NOTHROW : m_data(nullptr), m_size(0) {}
+
+    // Constructor from char16_t array literal (e.g. u"hello")
+    template <std::size_t N>
+    constexpr QStringView(const char16_t (&str)[N]) Q_DECL_NOTHROW
+        : m_data(str), m_size(static_cast<int>(N) - 1) {}
+
+    // Constructor from pointer + size
+    constexpr QStringView(const char16_t* str, int size) Q_DECL_NOTHROW
+        : m_data(str), m_size(size) {}
+
+    // Constructor from QString (holds a reference - caller must keep QString alive)
+    inline QStringView(const QString& str) Q_DECL_NOTHROW
+        : m_data(reinterpret_cast<const char16_t*>(str.utf16())), m_size(str.size()) {}
+
+    // Convert to QString
+    inline QString toString() const
+    {
+        if (!m_data || m_size == 0)
+            return QString();
+        return QString::fromUtf16(reinterpret_cast<const ushort*>(m_data), m_size);
+    }
+
+    inline operator QString() const { return toString(); }
+
+    constexpr int size() const Q_DECL_NOTHROW { return m_size; }
+    constexpr int length() const Q_DECL_NOTHROW { return m_size; }
+    constexpr bool isEmpty() const Q_DECL_NOTHROW { return m_size == 0; }
+    constexpr bool isNull() const Q_DECL_NOTHROW { return m_data == nullptr; }
+    constexpr const char16_t* data() const Q_DECL_NOTHROW { return m_data; }
+    constexpr const char16_t* utf16() const Q_DECL_NOTHROW { return m_data; }
+
+    inline bool operator==(const QStringView& other) const Q_DECL_NOTHROW
+    {
+        if (m_size != other.m_size)
+            return false;
+        if (!m_data && !other.m_data)
+            return true;
+        if (!m_data || !other.m_data)
+            return false;
+        return std::memcmp(m_data, other.m_data,
+                           static_cast<std::size_t>(m_size) * sizeof(char16_t)) == 0;
+    }
+
+    inline bool operator!=(const QStringView& other) const Q_DECL_NOTHROW
+    { return !(*this == other); }
+
+    inline bool operator==(const QString& s) const
+    { return toString() == s; }
+
+    inline bool operator==(QLatin1String s) const
+    { return toString() == s; }
+
+    // Additional QStringView methods — not present in Qt 5.6.3
+    inline bool startsWith(const QString& s, Qt::CaseSensitivity cs = Qt::CaseSensitive) const
+    { return toString().startsWith(s, cs); }
+    inline bool startsWith(QChar c, Qt::CaseSensitivity cs = Qt::CaseSensitive) const
+    { return toString().startsWith(c, cs); }
+    inline bool startsWith(QLatin1String s, Qt::CaseSensitivity cs = Qt::CaseSensitive) const
+    { return toString().startsWith(s, cs); }
+    inline bool endsWith(const QString& s, Qt::CaseSensitivity cs = Qt::CaseSensitive) const
+    { return toString().endsWith(s, cs); }
+    inline bool contains(const QString& s, Qt::CaseSensitivity cs = Qt::CaseSensitive) const
+    { return toString().contains(s, cs); }
+    inline QStringView right(int n) const
+    {
+        if (n >= m_size) return *this;
+        return QStringView(m_data + m_size - n, n);
+    }
+    inline QStringView left(int n) const
+    {
+        if (n >= m_size) return *this;
+        return QStringView(m_data, n);
+    }
+    inline QStringView mid(int pos, int n = -1) const
+    {
+        if (pos >= m_size) return QStringView(m_data + m_size, 0);
+        if (n < 0 || pos + n > m_size) n = m_size - pos;
+        return QStringView(m_data + pos, n);
+    }
+};
+
+// Allow QString == QStringView
+inline bool operator==(const QString& a, const QStringView& b)
+{ return a == b.toString(); }
+
+inline bool operator!=(const QString& a, const QStringView& b)
+{ return a != b.toString(); }
+
+QT_END_NAMESPACE
+
+#endif // QSTRINGVIEW_H
