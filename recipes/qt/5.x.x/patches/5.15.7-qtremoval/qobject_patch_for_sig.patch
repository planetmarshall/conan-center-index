diff --git a/qtbase/src/corelib/kernel/kobject.h b/qtbase/src/corelib/kernel/kobject.h
--- a/qtbase/src/corelib/kernel/kobject.h
+++ b/qtbase/src/corelib/kernel/kobject.h
@@ -0,0 +1,57 @@
+/****************************************************************************
+**
+** Local extension: KObject base class for QObject.
+**
+****************************************************************************/
+
+#ifndef QTCORE_KOBJECT_H
+#define QTCORE_KOBJECT_H
+
+#include <QtCore/qglobal.h>
+
+#include <thread>
+#include <memory>
+#include <utility>
+#include "KThread.h"
+
+#if !defined(QT_BOOTSTRAPPED) && !defined(QT_KOBJECT_NO_BOOST)
+#include <boost/asio.hpp>
+#endif
+
+QT_BEGIN_NAMESPACE
+
+class Q_CORE_EXPORT KObject
+{
+public:
+    virtual ~KObject() = default;
+
+    virtual void deleteLater() { delete this; }
+
+    // Equivalent to QObject::moveToThread()
+    void moveToThread(KThread *target_thread)
+    {
+        current_thread = target_thread;
+    }
+
+    // A helper to "invoke" code on this object's thread.
+    template <typename Func>
+    void invoke(Func &&func)
+    {
+#if !defined(QT_BOOTSTRAPPED) && !defined(QT_KOBJECT_NO_BOOST)
+        if (current_thread) {
+            boost::asio::post(kthread_context(current_thread), std::forward<Func>(func));
+        } else {
+            func(); // Fallback to current thread if no thread assigned
+        }
+#else
+        func();
+#endif
+    }
+
+protected:
+    KThread *current_thread = nullptr;
+};
+
+QT_END_NAMESPACE
+
+#endif // QTCORE_KOBJECT_H
